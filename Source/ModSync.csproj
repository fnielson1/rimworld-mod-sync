<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ModSync</AssemblyName>
    <RootNamespace>ModSync</RootNamespace>
    <OutputPath>..\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <Nullable>disable</Nullable>

    <!-- Only used by Deploy. Override if your install lives elsewhere: dotnet build -p:RimWorldDir="D:\Games\RimWorld" -->
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDir>
  </PropertyGroup>

  <!-- Reference-only packages, so the mod builds without RimWorld installed (e.g. in CI). Nothing is copied to the output. -->
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony" Version="2.4.3" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- dotnet build -p:Deploy=true copies the built mod into RimWorld\Mods\ModSync -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <ItemGroup>
      <AboutFiles Include="..\About\**\*" />
      <AssemblyFiles Include="..\1.6\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AboutFiles)" DestinationFiles="@(AboutFiles->'$(RimWorldDir)\Mods\ModSync\About\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(AssemblyFiles)" DestinationFiles="@(AssemblyFiles->'$(RimWorldDir)\Mods\ModSync\1.6\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
